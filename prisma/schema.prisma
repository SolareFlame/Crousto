generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id       String @id @default(cuid())
  sourceId Int    @unique

  title        String
  zone         String?
  latitude     Float?
  longitude    Float?
  thumbnailUrl String?
  shortDesc    String?

  contactHtml String? @map("contact")
  infosHtml   String? @map("infos")

  json     Json?
  jsonHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menus         Menu[]
  subscriptions Subscription[]
  plannings     Planning[]

  @@index([title])
  @@index([zone])
  @@index([latitude, longitude])
}

model Planning {
  id           String  @id @default(cuid())
  restaurantId String
  weekday      Int
  isOpen       Boolean
  label        String?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([restaurantId, weekday])
  @@index([restaurantId, weekday])
}

model Menu {
  id       String @id @default(cuid())
  sourceId Int    @unique

  restaurantId       String
  restaurantSourceId Int

  date      DateTime
  fetchedAt DateTime @default(now())

  json     Json?
  jsonHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant      Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  meals           Meal[]
  ratings         Rating[]
  TokenOccurrence TokenOccurrence[]

  @@unique([restaurantId, date, jsonHash])
  @@index([date])
  @@index([restaurantId, date])
  @@index([restaurantId, date, fetchedAt])
  @@index([restaurantId, date, sourceId])
}

model Meal {
  id       String @id @default(cuid())
  menuId   String
  name     String
  position Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menu       Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  categories Category[]

  @@unique([menuId, name])
  @@unique([menuId, position])
  @@index([menuId])
}

model Category {
  id       String @id @default(cuid())
  mealId   String
  label    String
  position Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meal   Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  dishes Dish[]

  @@unique([mealId, position])
  @@index([label])
  @@index([mealId])
}

model Dish {
  id         String @id @default(cuid())
  categoryId String
  label      String
  position   Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([categoryId, position])
  @@index([label])
  @@index([categoryId])
}

model Guild {
  guildId String  @id
  name    String?
  ownerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
}

model User {
  userId String  @id
  name   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ratings Rating[]
}

model Rating {
  id String @id @default(cuid())

  menuId String
  userId String

  rating Int // 1 to 5

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: Cascade)
  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, menuId])
  @@index([menuId, rating])
}

model Subscription {
  id           String  @id @default(cuid())
  guildId      String
  channelId    String
  restaurantId String
  mealName     String  @default("midi")
  roleId       String?
  active       Boolean @default(true)
  cron         String  @default("0 10 * * 1-5")

  lastRunAt     DateTime?
  lastMessageId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild      Guild      @relation(fields: [guildId], references: [guildId], onDelete: Cascade, onUpdate: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([active, cron])
  @@index([guildId, active])
}

// ==========================================
//                  STATS
// ==========================================

model TokenOccurrence {
  id String @id @default(cuid())

  token String
  label String

  menuId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menu Menu @relation(fields: [menuId], references: [id])

  ClusterAffectation ClusterAffectation[]
  TokenCluster       TokenCluster[]

  @@index([token])
  @@index([menuId])
}

// GENERATED AT EACH STATS REFRESH
model TokenCluster {
  id Int @id @default(autoincrement())

  masterTokenId String?
  masterToken   TokenOccurrence? @relation(fields: [masterTokenId], references: [id])

  createdAt DateTime @default(now())

  members ClusterAffectation[]
}

model ClusterAffectation {
  id    Int @id @default(autoincrement())
  count Int

  tokenId String
  token   TokenOccurrence @relation(fields: [tokenId], references: [id])

  clusterId Int
  cluster   TokenCluster @relation(fields: [clusterId], references: [id])
}
